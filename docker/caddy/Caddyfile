# Proxy público do pokemon-showdown-custom.
#
# Substitui o Apache + .htaccess do cliente original. Um único domínio serve:
#   - o cliente web (arquivos estáticos)
#   - o login server próprio (/~~{id}/action.php e /api/*)
#   - o servidor de jogo (WebSocket em /showdown/*)
#
# Em "localhost" o Caddy usa automaticamente uma CA local (certificado de dev).
# Em produção, com um domínio real, ele emite o certificado via Let's Encrypt.

# Logs (decisão do usuário, 2026-10-18; ver docs/revisao-seguranca-lgpd.md):
#   - o log padrão (stdout, guardado pelo Docker por tamanho) fica SEM IP: os avisos
#     do proxy trazem o pedido inteiro, e o IP só deve existir no log de acesso;
#   - o log de acesso de cada site (abaixo) guarda o IP por 14 dias, para segurança.
{
	# A CA local (só em *.localhost) não é instalada no sistema do container, que é
	# somente leitura e roda sem root. O navegador confia nela por fora, se quiser.
	skip_install_trust

	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers>X-Forwarded-For delete
				request>headers>Referer delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>uri regexp \?.* ?
			}
		}
	}
}

# Log de acesso (segurança, legítimo interesse): IP, data, método, caminho, status e
# tamanho de cada pedido, num arquivo só do root da VPS. A rotação diária e o
# apagamento depois de 14 dias ficam com o logrotate do sistema
# (docker/logrotate/ps-custom-caddy), porque a rotação do Caddy é por tamanho.
# Sem query string (links de convite e de redefinição levam códigos na URL) e sem
# Referer (pode trazer a URL anterior com esses códigos). Cookies e Authorization o
# Caddy já omite por padrão.
(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_disabled
			mode 0600
		}
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* ?
				request>headers>Referer delete
			}
		}
	}
}

# www.{domínio} só redireciona para o domínio principal (precisa do registro DNS do www;
# ver docs/deploy-vps.md). Cookies e o login valem só no domínio principal.
www.{$PS_HOST:localhost} {
	import access_log
	header Strict-Transport-Security "max-age=31536000"
	redir https://{$PS_HOST:localhost}{uri} permanent
}

{$PS_HOST:localhost} {
	import access_log
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# Só HTTPS por 1 ano (o Caddy já redireciona HTTP; isto evita o primeiro acesso em HTTP)
		Strict-Transport-Security "max-age=31536000"
		# O cliente não usa câmera, microfone, localização etc.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
	}

	# Caminhos que não devem ser expostos (código PHP legado, artefatos internos)
	# (exceto o action.php, que é atendido pelo login server)
	@blocked {
		path_regexp blocked (\.php$|/\.htaccess$|^/\.git/|^/caches/|^/lib/)
		not path_regexp ^/~~[^/]+/action\.php$
	}
	handle @blocked {
		respond 404
	}

	# Servidor de jogo
	@game path /showdown/*
	handle @game {
		reverse_proxy server:8000
	}

	# Login server próprio: contrato do action.php oficial + páginas de conta.
	# (A API /internal/* do login NÃO é roteada: só a rede do Docker a alcança.)
	@login path_regexp login ^/(~~[^/]+/action\.php|api(/.*)?|cadastro|redefinir|privacidade|regras|conta(/(sair|senha|excluir))?|conta\.js)/?$
	handle @login {
		reverse_proxy login:9000
	}

	# O /rules do PS aponta para https://{host}/rules (em pt, /pages/rules-pt): as
	# regras do servidor são as nossas, em /regras. Sem isto, /rules abriria o cliente
	# numa sala chamada "rules".
	@rules path /rules /rules/ /pages/rules-pt
	handle @rules {
		# O "*" é obrigatório: sem ele, o Caddy lê /regras como filtro de caminho
		redir * /regras 301
	}

	# Sprites e sons: servidos do nosso disco, a partir dos pacotes oficiais do PS
	# (scripts/recursos-ps.sh, em client/play.pokemonshowdown.com/{sprites,audio}, fora
	# do git; ver docs/recursos-ps.md). O que faltar (ex.: um Pokémon mais novo que o
	# pacote) vem do site oficial como reserva (decisão do usuário, 2026-10-18).
	#
	# Segurança e LGPD da reserva: o pedido sai do nosso domínio para um terceiro. Nada
	# que identifique o jogador vai junto: sem cookie de sessão, sem IP (X-Forwarded-*),
	# sem Referer; e nenhum cookie do terceiro volta para o nosso domínio.
	# Sprites próprios (assets/sprites, no git, arte nossa): por enquanto, o mato alto
	# dos selvagens da Expedição, como avatar "#expedition..." (trainers-custom no cliente).
	# Só o nosso prefixo; o que não existir dá 404, sem ir ao site oficial.
	@oursprites path_regexp oursprites ^/sprites/trainers-custom/expedition[a-z0-9-]*\.png$
	handle @oursprites {
		uri strip_prefix /sprites
		root * /srv/our-sprites
		header Cache-Control "public, max-age=86400"
		file_server
	}

	@remoteassets path /sprites/* /audio/*
	handle @remoteassets {
		root * /srv/client/play.pokemonshowdown.com
		@localasset file
		handle @localasset {
			header Cache-Control "public, max-age=604800"
			file_server
		}
		handle {
			reverse_proxy https://play.pokemonshowdown.com {
				header_up Host {upstream_hostport}
				header_up -Cookie
				header_up -Authorization
				header_up -Referer
				header_up -X-Forwarded-For
				header_up -X-Forwarded-Host
				header_up -X-Forwarded-Proto
				header_up -Via
				header_down -Set-Cookie
			}
		}
	}

	# Imagens das insígnias do Desafio de Ginásios (assets/badges, fora do git; ver
	# docs/insignias.md). Nomes fixos por id: podem ficar em cache por um dia.
	@badges path_regexp badges ^/badges/[a-z0-9-]+\.png$
	handle @badges {
		uri strip_prefix /badges
		root * /srv/badges
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle /badges/* {
		respond 404
	}

	# Config do cliente gerada no build (volume client-config). No repositório,
	# play.pokemonshowdown.com/config/* são symlinks para ../../config/, que no
	# Windows viram arquivos de texto; por isso servimos direto do volume.
	@clientconfig path /config/*
	handle @clientconfig {
		uri strip_prefix /config
		root * /srv/client-config
		file_server
	}

	# Páginas de teste do cliente (não fazem parte do site)
	@testclient path_regexp testclient ^/testclient-[a-z]+\.html$
	handle @testclient {
		respond 404
	}

	# Cliente web
	handle {
		root * /srv/client/play.pokemonshowdown.com

		# Só o cliente CLÁSSICO é servido (decisão do projeto, 2026-10-17: o cliente
		# novo/Preact ainda é alpha). Toda rota de página, inclusive as que o
		# .htaccess original mandava para o cliente novo (/preactalpha, /newclient,
		# cookie preactalpha=1...), abre o clássico. Para reativar o novo, ver as
		# regras do .htaccess em client/play.pokemonshowdown.com/.
		@clientpage path_regexp ^/[A-Za-z0-9-]*$
		rewrite @clientpage /caches/index-old.html
		rewrite /crossprotocol.html /caches/crossprotocol.html

		# O header é avaliado antes do rewrite: casa com a URL original das páginas do cliente
		@indexpage path_regexp ^/[A-Za-z0-9-]*$
		header @indexpage Cache-Control "no-cache, no-store, must-revalidate"

		file_server
	}
}
