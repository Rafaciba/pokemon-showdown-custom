# Proxy público do pokemon-showdown-custom.
#
# Substitui o Apache + .htaccess do cliente original. Um único domínio serve:
#   - o cliente web (arquivos estáticos)
#   - o login server próprio (/~~{id}/action.php e /api/*)
#   - o servidor de jogo (WebSocket em /showdown/*)
#
# Em "localhost" o Caddy usa automaticamente uma CA local (certificado de dev).
# Em produção, com um domínio real, ele emite o certificado via Let's Encrypt.

{$PS_HOST:localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# Só HTTPS por 1 ano (o Caddy já redireciona HTTP; isto evita o primeiro acesso em HTTP)
		Strict-Transport-Security "max-age=31536000"
		# O cliente não usa câmera, microfone, localização etc.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
	}

	# Caminhos que não devem ser expostos (código PHP legado, artefatos internos)
	# (exceto o action.php, que é atendido pelo login server)
	@blocked {
		path_regexp blocked (\.php$|/\.htaccess$|^/\.git/|^/caches/|^/lib/)
		not path_regexp ^/~~[^/]+/action\.php$
	}
	handle @blocked {
		respond 404
	}

	# Servidor de jogo
	@game path /showdown/*
	handle @game {
		reverse_proxy server:8000
	}

	# Login server próprio: contrato do action.php oficial + páginas de conta.
	# (A API /internal/* do login NÃO é roteada: só a rede do Docker a alcança.)
	@login path_regexp login ^/(~~[^/]+/action\.php|api(/.*)?|cadastro|redefinir|privacidade|conta(/(sair|senha|excluir))?)/?$
	handle @login {
		reverse_proxy login:9000
	}

	# PROVISÓRIO: sprites e áudio não estão no repositório do cliente.
	# Enquanto não hospedamos esses arquivos, buscamos no site oficial (só imagens e
	# sons; o pokedex-mini(-bw).js, que é JavaScript, é baixado uma vez no build do
	# cliente e servido localmente, ver docker/client/build.sh).
	#
	# Segurança e LGPD: o pedido sai do nosso domínio para um terceiro. Nada que
	# identifique o jogador vai junto: sem cookie de sessão, sem IP (X-Forwarded-*),
	# sem Referer; e nenhum cookie do terceiro volta para o nosso domínio.
	@remoteassets path /sprites/* /audio/*
	handle @remoteassets {
		reverse_proxy https://play.pokemonshowdown.com {
			header_up Host {upstream_hostport}
			header_up -Cookie
			header_up -Authorization
			header_up -Referer
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -Via
			header_down -Set-Cookie
		}
	}

	# Config do cliente gerada no build (volume client-config). No repositório,
	# play.pokemonshowdown.com/config/* são symlinks para ../../config/, que no
	# Windows viram arquivos de texto; por isso servimos direto do volume.
	@clientconfig path /config/*
	handle @clientconfig {
		uri strip_prefix /config
		root * /srv/client-config
		file_server
	}

	# Páginas de teste do cliente (não fazem parte do site)
	@testclient path_regexp testclient ^/testclient-[a-z]+\.html$
	handle @testclient {
		respond 404
	}

	# Cliente web
	handle {
		root * /srv/client/play.pokemonshowdown.com

		# Só o cliente CLÁSSICO é servido (decisão do projeto, 2026-10-17: o cliente
		# novo/Preact ainda é alpha). Toda rota de página, inclusive as que o
		# .htaccess original mandava para o cliente novo (/preactalpha, /newclient,
		# cookie preactalpha=1...), abre o clássico. Para reativar o novo, ver as
		# regras do .htaccess em client/play.pokemonshowdown.com/.
		@clientpage path_regexp ^/[A-Za-z0-9-]*$
		rewrite @clientpage /caches/index-old.html
		rewrite /crossprotocol.html /caches/crossprotocol.html

		# O header é avaliado antes do rewrite: casa com a URL original das páginas do cliente
		@indexpage path_regexp ^/[A-Za-z0-9-]*$
		header @indexpage Cache-Control "no-cache, no-store, must-revalidate"

		file_server
	}
}
