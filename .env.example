# Copie para .env e ajuste se necessário (o .env nunca vai para o git).

# Domínio público. Em desenvolvimento: ps.localhost (qualquer *.localhost aponta
# para a própria máquina). NÃO use "localhost" puro: o cliente clássico do PS
# força ws:// sem TLS nesse caso e não conecta.
PS_HOST=ps.localhost
# Na VPS (produção): PS_HOST=ligadesafios.com.br

# ID da chave de login anunciado pelo servidor de jogo (só mude se trocar a chave).
LOGIN_KEY_ID=1

# 1 = força o build completo do cliente (regenera pokédex/formatos a partir do server/).
CLIENT_FORCE_BUILD=0

# 1 = desliga as checagens por IP do PS (ladder pareia jogadores do mesmo IP,
# sem limites por IP). Útil para testar com duas abas na mesma máquina.
PS_NO_IP_CHECKS=0

# Administradores (rank ~), separados por vírgula. Cada um precisa criar a conta
# com um convite (docker compose exec login node src/cli.ts convite --nome NOME).
PS_ADMINS=
